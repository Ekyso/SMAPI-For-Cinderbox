@using StardewModdingAPI.Web.Framework.Extensions
@{
    ViewData["Title"] = "Mod stats";
}
@section Head {
    @* Apache ECharts *@
    <script src="@Url.ContentWithCacheBust("~/Content/lib/echarts/dist/echarts.min.js")"></script>

    @* jQuery *@
    <script src="@Url.ContentWithCacheBust("~/Content/lib/jquery/dist/jquery.min.js")"></script>

    @* Vue *@
    <script src="@Url.ContentWithCacheBust("~/Content/lib/vue/dist/vue.min.js")"></script>

    @* page CSS/JS *@
    <link rel="stylesheet" href="@Url.ContentWithCacheBust("~/Content/css/stats.css")" />
    <script src="@Url.ContentWithCacheBust("~/Content/js/stats.js")"></script>
    <script>
        $(function () {
            smapi.statsPage({
                modsByTypeUri: @this.ForJson(Url.ContentWithCacheBust("~/Content/data/mods-by-type.jsonl")),
                contentPacksByFormatUri: @this.ForJson(Url.ContentWithCacheBust("~/Content/data/content-packs-by-format.jsonl"))
            });
        });
    </script>
}

@* quick navigation links *@
@section SidebarExtra {
    <nav id="quickNav" hidden>
        <h4>Scroll to...</h4>
        <ul>
            <li><a href="#content">Top</a></li>
            <li><a href="#mods-by-type">Mods by type</a></li>
            <li><a href="#new-mods">New mods</a></li>
            <li><a href="#content-patcher-packs">Content Patcher packs</a></li>
        </ul>
    </nav>
}

<noscript>
    <div class="banner error">
        <strong>This page requires JavaScript.</strong><br />
        This pages uses JavaScript to render the stats. To view them, please enable JavaScript or <a href="https://github.com/Pathoschild/StardewModData">view the raw data</a>.
    </div>
</noscript>

<div v-cloak id="app">
    @* loading indicator *@
    <div v-if="!isDataLoaded && !isDataFailed" class="loading-indicator"><div></div><div></div><div></div><div></div></div>

    @* error state *@
    <div v-if="isDataFailed" class="error">↻ The mod data hasn't been fetched yet; please try again in a few minutes.</div>

    @* stats area *@
    <div v-if="isDataLoaded" id="stats-area">
        @* header *@
        <div id="stats-intro">These stats are generated automatically from the <a href="https://github.com/Pathoschild/StardewModData">Stardew mod dataset</a>.</div>
        <div id="stats-controls">
            <label>
                <input type="checkbox" v-model="showAdvancedControls"/>
                Enable advanced controls
            </label>
        </div>

        @* mods by type *@
        <h2 id="mods-by-type">Mods by type</h2>
        <div class="last-updated">Based on data from {{modsByType.lastUpdated}}.</div>

        <div class="chart-intro">We have {{modsByType.total.toLocaleString()}} tracked mods. The majority use {{modsByType.topThree[0].label}} ({{modsByType.topThree[0].percent}}%), followed by {{modsByType.topThree[1].label}} at {{modsByType.topThree[1].percent}}% and {{modsByType.topThree[2].label}} at {{modsByType.topThree[2].percent}}%. <a href="https://stardewvalleywiki.com/Modding:Using_XNB_mods">Legacy XNB mods</a> are no longer recommended, and now only make up {{modsByType.xnbPercent}}% of mods.</div>
        <div class="chart pie-chart" id="modsByType"></div>
        <div class="chart line-chart" id="modsByTypeOverTime"></div>
        <div class="chart line-chart" id="modsByTypeOverTimeExcludingOutliers"></div>

        @* new mods *@
        <h2 id="new-mods">New mods</h2>
        <div class="last-updated">Based on data from {{modsByType.lastUpdated}}.</div>
        <div class="chart-intro">
            Between {{modsByType.previouslyUpdated}} and {{modsByType.lastUpdated}}, there were {{latestNewMods.total.toLocaleString()}} more mods. That includes:
            <ul>
                <li v-for="entry in latestNewMods.byType">{{formatDelta(entry.delta)}} {{entry.label}};</li>
                <li>and {{formatDelta(latestNewMods.forOther)}} for frameworks with &lt;100 content packs.</li>
            </ul>
        </div>
        <div class="chart pie-chart" id="newModsLastDelta"></div>
        <div class="chart bar-chart" id="newMods"></div>

        @* Content Patcher packs *@
        <h2 id="content-patcher-packs">Content Patcher packs</h2>
        <div class="last-updated">Based on data from {{contentPacks.lastUpdated}}.</div>

        <div class="chart-intro">
            We have {{contentPacks.total.toLocaleString()}} tracked <a href="https://www.nexusmods.com/stardewvalley/mods/1915">Content Patcher</a> packs. The top five format versions are (with the change since {{contentPacks.previouslyUpdated}}):
            <ul>
                <li v-for="(entry, i) in contentPacks.topVersions">{{i == 4 ? "and " : ""}} {{entry.version}} ({{entry.count.toLocaleString()}}, {{formatDelta(entry.delta)}}){{i < 4 ? ";" : "."}}</li>
            </ul>
        </div>

        <div class="chart pie-chart" id="contentPacksByFormat"></div>
        <div class="chart line-chart" id="contentPacksByFormatOverTime"></div>
    </div>
</div>
