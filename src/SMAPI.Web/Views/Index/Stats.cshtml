@using StardewModdingAPI.Web.Framework.Extensions
@{
    ViewData["Title"] = "Mod stats";
}
@section Head {
    @* Apache ECharts *@
    <script src="@Url.ContentWithCacheBust("~/Content/lib/echarts/dist/echarts.min.js")"></script>

    @* jQuery *@
    <script src="@Url.ContentWithCacheBust("~/Content/lib/jquery/dist/jquery.min.js")"></script>

    @* Vue *@
    <script src="@Url.ContentWithCacheBust("~/Content/lib/vue/dist/vue.min.js")"></script>

    @* page CSS/JS *@
    <link rel="stylesheet" href="@Url.ContentWithCacheBust("~/Content/css/stats.css")" />
    <script src="@Url.ContentWithCacheBust("~/Content/js/stats.js")"></script>
    <script>
        $(function () {
            smapi.statsPage({
                modsByTypeUri: @this.ForJson(Url.ContentWithCacheBust("~/Content/data/mods-by-type.jsonl"))
            });
        });
    </script>
}

<noscript>
    <div class="banner error">
        <strong>This page requires JavaScript.</strong><br />
        This pages uses JavaScript to render the stats. To view them, please enable JavaScript or <a href="https://github.com/Pathoschild/StardewModData">view the raw data</a>.
    </div>
</noscript>

<div v-cloak id="app">
    @* loading indicator *@
    <div v-if="!isLoaded && !loadFailed" class="loading-indicator"><div></div><div></div><div></div><div></div></div>

    @* error state *@
    <div v-if="loadFailed" class="error">↻ The mod data hasn't been fetched yet; please try again in a few minutes.</div>

    @* stats area *@
    <div v-if="isLoaded" id="stats-area">
        <div id="stats-intro">These stats are generated automatically from the <a href="https://github.com/Pathoschild/StardewModData">Stardew mod dataset</a>, last updated on {{modsByType.lastUpdated}}.</div>

        <h2>Mods by type</h2>
        <div class="chart-intro">We have {{modsByType.summary.total.toLocaleString()}} tracked mods. The majority use {{modsByType.summary.topThree[0].label}} ({{modsByType.summary.topThree[0].percent}}%), followed by {{modsByType.summary.topThree[1].label}} at {{modsByType.summary.topThree[1].percent}}% and {{modsByType.summary.topThree[2].label}} at {{modsByType.summary.topThree[2].percent}}%. <a href="https://stardewvalleywiki.com/Modding:Using_XNB_mods">Legacy XNB mods</a> are no longer recommended, and now only make up {{modsByType.summary.xnbPercent}}% of mods.</div>
        <div class="chart" id="modsByType"></div>
        <div class="chart" id="modsByTypeOverTime"></div>
        <div class="chart" id="modsByTypeOverTimeExcludingOutliers"></div>

        <h2>New mods</h2>
        <div class="chart-intro">
            Between {{modsByType.previouslyUpdated}} and {{modsByType.lastUpdated}}, there were {{latestNewMods.total.toLocaleString()}} more mods. That includes:
            <ul>
                <li v-for="entry in latestNewMods.byType">{{formatDelta(entry.delta)}} {{entry.label}};</li>
                <li>and {{formatDelta(latestNewMods.forOther)}} for frameworks with &lt;100 content packs.</li>
            </ul>
        </div>
        <div class="chart" id="newModsLastDelta"></div>
        <div class="chart" id="newMods"></div>
    </div>
</div>
